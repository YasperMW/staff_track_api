# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Core API
# ---------------------------------------------------------------------------
APP_TIMEZONE=Africa/Blantyre
API_HOST=0.0.0.0
API_PORT=8888
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/staff_track

# ---------------------------------------------------------------------------
# Auth / bootstrap
# ---------------------------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
NOTIFY_AFTER_FAILED_ATTEMPTS=3
OTP_EXPIRY_MINUTES=10

# Password for the seeded System Admin account (only used when the DB has no users).
# If unset, a random password is generated and written to the startup log.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@stafftrack.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# ---------------------------------------------------------------------------
# Email (Resend or SMTP)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Staff Track

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging
# Either provide a service account file path, or the individual values below.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ---------------------------------------------------------------------------
# Holidays sync
# ---------------------------------------------------------------------------
HOLIDAYS_SYNC_ENABLED=true
HOLIDAYS_SYNC_COUNTRY=MW
HOLIDAYS_API_PROVIDER=
HOLIDAYS_API_KEY=

# ---------------------------------------------------------------------------
# Uploads / geofencing
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXT=.png,.jpg,.jpeg,.pdf
GEOFENCE_CENTER_LAT=
GEOFENCE_CENTER_LON=
GEOFENCE_RADIUS_METERS=

# One-off attendance repair on startup (leave false unless needed)
ATTENDANCE_FIX_ENABLED=false
