# Timezone Configuration
# Set your desired timezone here. This will be used across all endpoints
# Find your timezone at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
APP_TIMEZONE=Africa/Blantyre

# Examples for other timezones:
# APP_TIMEZONE=America/New_York
# APP_TIMEZONE=Europe/London
# APP_TIMEZONE=Asia/Dubai
# APP_TIMEZONE=Australia/Sydney

# API Configuration
API_HOST=0.0.0.0
API_PORT=8888
DEBUG=false

# CORS Configuration
CORS_ORIGINS=*

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/staff_track

# Holiday Sync Configuration
HOLIDAYS_SYNC_ENABLED=true
HOLIDAYS_SYNC_COUNTRY=MW

# Email Configuration (if using email notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# FCM Configuration (if using push notifications)
FCM_SERVER_KEY=your-fcm-server-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here
